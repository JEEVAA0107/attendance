{
    "name": "SmartAttend - SMS Queue Processor",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "minutes",
                            "minutesInterval": 5
                        }
                    ]
                }
            },
            "id": "schedule-trigger",
            "name": "Every 5 Minutes",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                240,
                300
            ]
        },
        {
            "parameters": {
                "method": "GET",
                "url": "={{ $env.SMARTATTEND_API_URL }}/webhooks/data/sms-queue",
                "options": {
                    "timeout": 30000
                }
            },
            "id": "fetch-queue",
            "name": "Fetch SMS Queue",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                460,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": "",
                        "typeValidation": "strict"
                    },
                    "conditions": [
                        {
                            "leftValue": "={{ $json.count }}",
                            "rightValue": 0,
                            "operator": {
                                "type": "number",
                                "operation": "gt"
                            }
                        }
                    ],
                    "combinator": "and"
                },
                "options": {}
            },
            "id": "has-messages",
            "name": "Has Pending SMS?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                680,
                300
            ]
        },
        {
            "parameters": {
                "fieldToSplitOut": "messages",
                "options": {}
            },
            "id": "split-messages",
            "name": "Split Into Individual SMS",
            "type": "n8n-nodes-base.splitOut",
            "typeVersion": 1,
            "position": [
                900,
                220
            ]
        },
        {
            "parameters": {
                "operation": "send",
                "from": "={{ $env.TWILIO_PHONE }}",
                "to": "={{ $json.phone_number }}",
                "message": "={{ $json.message }}"
            },
            "id": "send-sms",
            "name": "Send SMS via Twilio",
            "type": "n8n-nodes-base.twilio",
            "typeVersion": 1,
            "position": [
                1120,
                220
            ],
            "credentials": {
                "twilioApi": {
                    "id": "TWILIO_CREDENTIAL_ID",
                    "name": "Twilio Account"
                }
            },
            "onError": "continueRegularOutput"
        },
        {
            "parameters": {
                "method": "PUT",
                "url": "={{ $env.SMARTATTEND_API_URL }}/webhooks/data/sms-queue/{{ $json.id }}/sent",
                "options": {
                    "timeout": 10000
                }
            },
            "id": "mark-sent",
            "name": "Mark SMS as Sent",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1340,
                220
            ]
        },
        {
            "parameters": {
                "aggregate": "aggregateIndividualFields",
                "fieldsToAggregate": {
                    "fieldToAggregate": [
                        {
                            "fieldToAggregate": "id"
                        }
                    ]
                },
                "options": {}
            },
            "id": "aggregate-results",
            "name": "Aggregate Results",
            "type": "n8n-nodes-base.aggregate",
            "typeVersion": 1,
            "position": [
                1560,
                220
            ]
        },
        {
            "parameters": {
                "mode": "runOnceForAllItems",
                "jsCode": "const items = $input.all();\nconst count = items.length;\n\nreturn [{\n  json: {\n    status: 'success',\n    message: `Processed ${count} SMS message(s)`,\n    count: count,\n    timestamp: new Date().toISOString()\n  }\n}];"
            },
            "id": "log-success",
            "name": "Log Processing Result",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1780,
                220
            ]
        },
        {
            "parameters": {},
            "id": "no-messages",
            "name": "No Pending Messages",
            "type": "n8n-nodes-base.noOp",
            "typeVersion": 1,
            "position": [
                900,
                400
            ]
        }
    ],
    "connections": {
        "Every 5 Minutes": {
            "main": [
                [
                    {
                        "node": "Fetch SMS Queue",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Fetch SMS Queue": {
            "main": [
                [
                    {
                        "node": "Has Pending SMS?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Has Pending SMS?": {
            "main": [
                [
                    {
                        "node": "Split Into Individual SMS",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "No Pending Messages",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Split Into Individual SMS": {
            "main": [
                [
                    {
                        "node": "Send SMS via Twilio",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Send SMS via Twilio": {
            "main": [
                [
                    {
                        "node": "Mark SMS as Sent",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Mark SMS as Sent": {
            "main": [
                [
                    {
                        "node": "Aggregate Results",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Aggregate Results": {
            "main": [
                [
                    {
                        "node": "Log Processing Result",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    },
    "tags": [
        {
            "name": "SmartAttend",
            "createdAt": "2024-01-01T00:00:00.000Z",
            "updatedAt": "2024-01-01T00:00:00.000Z"
        }
    ]
}